---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { fechaMx, categoriasNoticias, type Migaja } from '@lib/seo';

interface Props {
  entry: CollectionEntry<'noticias'>;
}

const { entry } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, author, category, tags, image, imageAlt } = entry.data;
const path = `/noticias/${entry.id}/`;
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: 'Noticias', url: '/noticias/' },
  { nombre: title, url: path },
];
---

<BaseLayout
  seo={{
    tipo: 'articulo',
    title,
    seoTitle,
    description,
    path,
    image: image?.src,
    migas,
    articulo: { publicado: pubDate, actualizado: updatedDate, autor: author, seccion: categoriasNoticias[category] },
  }}
>
  <Breadcrumbs migas={migas} />
  <article class="contenedor pt-10 md:pt-16">
    <header class="mx-auto max-w-3xl">
      <p class="etiqueta">{categoriasNoticias[category]}</p>
      <h1 class="mt-5 text-4xl font-medium leading-[1.05] tracking-display text-ink md:text-5xl">{title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{description}</p>
      <p class="mt-6 flex flex-wrap gap-x-3 border-b border-line pb-6 text-sm text-muted">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{fechaMx(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Actualizado: <time datetime={updatedDate.toISOString()}>{fechaMx(updatedDate)}</time></span>
          </>
        )}
      </p>
    </header>

    {image && (
      <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-2xl bg-paper">
        <Image src={image} alt={imageAlt ?? ''} widths={[640, 1024, 1440]} sizes="(min-width: 1024px) 1024px, 100vw" loading="eager" class="aspect-[16/9] w-full object-cover" />
      </div>
    )}

    <div class="prose prose-neutral prose-lg mx-auto mt-12 max-w-3xl prose-headings:font-medium prose-headings:tracking-tight prose-a:text-ink prose-a:underline-offset-4 prose-strong:font-medium">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="mx-auto mt-12 max-w-3xl border-t border-line pt-6">
        <p class="text-sm text-muted">{tags.map((t) => `#${t}`).join('  ')}</p>
      </footer>
    )}
  </article>
</BaseLayout>
