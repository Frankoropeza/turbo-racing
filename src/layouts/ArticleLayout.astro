---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { fechaMx, categoriasNoticias, type Migaja } from '@lib/seo';

interface Props {
  entry: CollectionEntry<'noticias'>;
}

const { entry } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, author, category, tags, image, imageAlt } = entry.data;
const path = `/noticias/${entry.id}/`;
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: 'Noticias', url: '/noticias/' },
  { nombre: title, url: path },
];
---

<BaseLayout
  seo={{
    tipo: 'articulo',
    title,
    seoTitle,
    description,
    path,
    image: image?.src,
    migas,
    articulo: { publicado: pubDate, actualizado: updatedDate, autor: author, seccion: categoriasNoticias[category] },
  }}
>
  <Breadcrumbs migas={migas} />
  <article class="max-w-3xl mx-auto px-4 pt-24 pb-16">
    <header class="mb-10">
      <p class="inline-block bg-primary/20 text-primary text-sm font-medium px-3 py-1 rounded-full uppercase tracking-wide mb-4">{categoriasNoticias[category]}</p>
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-light leading-tight mb-4">{title}</h1>
      <p class="text-lg text-light/70 mb-6">{description}</p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-light/60 border-b border-light/10 pb-6">
        <span>Por <strong class="text-light/85">{author}</strong></span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={pubDate.toISOString()}>{fechaMx(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>Actualizado: <time datetime={updatedDate.toISOString()}>{fechaMx(updatedDate)}</time></span>
          </>
        )}
      </div>
    </header>

    {image && (
      <Image
        src={image}
        alt={imageAlt ?? ''}
        widths={[640, 960, 1280]}
        sizes="(min-width: 768px) 768px, 100vw"
        loading="eager"
        class="w-full rounded-2xl border border-white/5 mb-10"
      />
    )}

    <div class="prose prose-invert prose-lg max-w-none prose-headings:font-heading prose-headings:text-light prose-a:text-primary hover:prose-a:text-primary/80 prose-strong:text-light prose-code:text-accent">
      <slot />
    </div>

    {tags.length > 0 && (
      <footer class="mt-12 pt-6 border-t border-light/10">
        <ul class="flex flex-wrap gap-2" aria-label="Etiquetas">
          {tags.map((tag) => <li class="bg-secondary text-light/75 text-xs px-3 py-1 rounded-full">#{tag}</li>)}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>
