---
import '../styles/global.css';
import { site } from '@config/site';
import type { SeoInput } from '@lib/seo';
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppFlotante from '@components/WhatsAppFlotante.astro';

interface Props {
  seo: SeoInput;
}

const { seo } = Astro.props;
---

<!doctype html>
<html lang={site.idioma} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.tema} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO seo={seo} />
    <slot name="head" />
  </head>
  <body class="bg-dark text-light font-sans min-h-screen flex flex-col antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] bg-primary-strong text-white px-4 py-2 rounded-md font-bold">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFlotante />
  </body>
</html>
