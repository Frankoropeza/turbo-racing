---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allNoticias = await getCollection('noticias', ({ data }) => !data.draft);
const noticias = allNoticias.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Noticias" description="Todas las noticias y novedades del mundo del automovilismo en Turbo Racing.">
  <section class="max-w-7xl mx-auto px-4 pt-28 pb-20">
    <div class="mb-12">
      <span class="text-accent text-sm font-semibold uppercase tracking-[0.2em]">Blog</span>
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-light mt-2">Noticias</h1>
      <p class="text-light/50 mt-3 max-w-2xl">Lo último del mundo del automovilismo, análisis técnicos y novedades de Turbo Racing.</p>
    </div>

    {noticias.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {noticias.map((noticia) => (
          <ArticleCard
            title={noticia.data.title}
            description={noticia.data.description}
            pubDate={noticia.data.pubDate}
            category={noticia.data.category}
            slug={noticia.slug}
            image={noticia.data.image}
          />
        ))}
      </div>
    ) : (
      <p class="text-light/50 text-center py-20">No hay noticias publicadas todavía.</p>
    )}
  </section>
</BaseLayout>
