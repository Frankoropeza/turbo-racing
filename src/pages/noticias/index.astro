---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ArticleCard from '@components/ArticleCard.astro';
import type { Migaja } from '@lib/seo';

const pagina = await getEntry('paginas', 'noticias');
if (!pagina) throw new Error('Falta src/content/paginas/noticias.md');
const { Content } = await render(pagina);
const noticias = (await getCollection('noticias', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: 'Noticias', url: '/noticias/' },
];
---

<BaseLayout
  seo={{
    tipo: 'noticias',
    title: pagina.data.title,
    seoTitle: pagina.data.seoTitle,
    description: pagina.data.description,
    path: '/noticias/',
    migas,
    items: noticias.map((n) => ({ nombre: n.data.title, url: `/noticias/${n.id}/` })),
  }}
>
  <Breadcrumbs migas={migas} />
  <section class="contenedor pt-10 md:pt-16">
    <SectionHeader badge={pagina.data.badge ?? 'Blog'} title={pagina.data.title} nivel="h1">
      <Content />
    </SectionHeader>

    {noticias.length > 0 ? (
      <h2 class="sr-only">Artículos publicados</h2>
      <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {noticias.map((n) => <ArticleCard noticia={n} />)}
      </div>
    ) : (
      <p class="py-20 text-center text-muted">Todavía no hay noticias publicadas.</p>
    )}
  </section>
</BaseLayout>
