---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import ArticleCard from '@components/ArticleCard.astro';
import type { Migaja } from '@lib/seo';

const pagina = await getEntry('paginas', 'noticias');
if (!pagina) throw new Error('Falta src/content/paginas/noticias.md');
const { Content } = await render(pagina);
const noticias = (await getCollection('noticias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: 'Noticias', url: '/noticias/' },
];
---

<BaseLayout
  seo={{
    tipo: 'noticias',
    title: pagina.data.title,
    seoTitle: pagina.data.seoTitle,
    description: pagina.data.description,
    path: '/noticias/',
    migas,
    items: noticias.map((n) => ({ nombre: n.data.title, url: `/noticias/${n.id}/` })),
  }}
>
  <Breadcrumbs migas={migas} />
  <section class="max-w-7xl mx-auto px-4 pt-28 pb-20">
    <div class="mb-12">
      <p class="text-blue-300 text-sm font-semibold uppercase tracking-[0.2em]">{pagina.data.badge}</p>
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-light mt-2">{pagina.data.title}</h1>
      <div class="text-light/70 mt-3 max-w-2xl"><Content /></div>
    </div>

    {noticias.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {noticias.map((n) => <ArticleCard noticia={n} />)}
      </div>
    ) : (
      <p class="text-light/70 text-center py-20">Todavía no hay noticias publicadas.</p>
    )}
  </section>
</BaseLayout>
