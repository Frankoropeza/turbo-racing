---
import BaseLayout from '@layouts/BaseLayout.astro';
import Boton from '@components/Boton.astro';
---

<BaseLayout seo={{ tipo: 'error', title: 'Página no encontrada', description: 'La página que buscas no existe o cambió de dirección. Vuelve al inicio de Turbo Racing o explora nuestros servicios.', path: '/404/', noindex: true }}>
  <section class="contenedor flex min-h-[60vh] flex-col justify-center py-24">
    <p class="etiqueta">Error 404</p>
    <h1 class="mt-5 max-w-3xl text-5xl font-medium leading-[1.02] tracking-display text-ink md:text-7xl">
      Esta página se salió <em class="acento">de la pista.</em>
    </h1>
    <div class="mt-10 flex flex-wrap gap-3">
      <Boton href="/">Volver al inicio</Boton>
      <Boton href="/contacto/" estilo="contorno">Contacto</Boton>
    </div>
  </section>
</BaseLayout>
