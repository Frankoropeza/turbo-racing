---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const carCats = [
  {
    title: 'Turbo Racing',
    category: 'Micro-Scale Pro',
    scale: '1:76',
    description: 'La ingeniería más pequeña del mundo. Control 100% proporcional en la palma de tu mano. Ideal para competencias de escritorio y circuitos ultra-compactos.',
    image: 'https://images.unsplash.com/photo-1594787318286-3d835c1d207f?auto=format&fit=crop&q=80',
    specs: ['USB-C Fast Charge', '40min Autonomía', 'Luces LED Reales', 'Control Proporcional']
  },
  {
    title: 'Kyosho Mini-Z',
    category: 'Precision Racing',
    scale: '1:28',
    description: 'El estándar de oro para el racing indoor. Chasis de alta ingeniería con componentes reemplazables y carrocerías de ultra-realismo con licencia oficial.',
    image: 'https://images.unsplash.com/photo-1532339142463-fd0a8979791a?auto=format&fit=crop&q=80',
    specs: ['Chasis Pro MR-03', 'RWD / AWD Opt.', 'Cientos de Autopartes', 'Syncro KT-531P']
  },
  {
    title: 'Kyosho Fazer',
    category: 'On-Road Touring',
    scale: '1:10',
    description: 'Fusión perfecta entre estética y rendimiento. Diseñados para devorar el asfalto con estabilidad total y un realismo visual en sus carrocerías clásicas y modernas.',
    image: 'https://images.unsplash.com/photo-1581235720704-06d3acfcb36f?auto=format&fit=crop&q=80',
    specs: ['Tracción 4WD', 'Chasis FZ02 Plt', 'Motor High Torque', 'Llantas de Agarre']
  },
  {
    title: 'Traxxas Bashers',
    category: 'Off-Road Action',
    scale: '1:10',
    description: 'Resistencia extrema para saltos y terrenos difíciles. Los vehículos más duraderos y rápidos diseñados para bashing agresivo en tierra, pasto o lodo.',
    image: 'https://images.unsplash.com/photo-1594787317351-7429d8a8467a?auto=format&fit=crop&q=80',
    specs: ['Electrónica VXL', '80+ KM/H Top', 'Waterproof Design', 'T-Maxx Ready']
  },
  {
    title: 'Rock Crawlers',
    category: 'Technical Path',
    scale: '1:10',
    description: 'Ingeniería enfocada en el torque y la articulación. Vencen cualquier obstáculo con precisión técnica. El arte de ir lento por donde nadie más puede.',
    image: 'https://images.unsplash.com/photo-1533558701576-23c65e42cddf?auto=format&fit=crop&q=80',
    specs: ['Bloqueo Dif.', 'Torque Superior', 'Llantas Soft Grip', 'Portales en Eje']
  },
  {
    title: 'Pro Drift',
    category: 'Style & Slide',
    scale: '1:10',
    description: 'El arte del deslizamiento controlado. Chasis RWD con giroscopios electrónicos de alta precisión para las mejores trayectorias de drifting profesional.',
    image: 'https://images.unsplash.com/photo-1547744152-14d985cb937f?auto=format&fit=crop&q=80',
    specs: ['Tracción RWD', 'Giroscopo Adj.', 'Llantas Hard Pol', 'Ajuste de Camber']
  }
];
---

<BaseLayout 
  title="Catálogo de Carros RC | Turbo Racing México"
  description="Explore nuestra selección curada de vehículos de radio control profesionales. Todas las escalas y especialidades técnicas disponibles en México."
>
  <!-- Hero Catalogo -->
  <section class="pt-32 pb-16 px-4 bg-secondary/10">
    <div class="max-w-7xl mx-auto">
      <SectionHeader 
        badge="Catálogo Técnico v2.6"
        title="Ingeniería sobre Ruedas"
        p1="Bienvenido a la selección más rigurosa de vehículos RC en México. Cada modelo ha sido probado bajo condiciones reales de competencia para garantizar el máximo rendimiento."
        p2="No solo vendemos autos, entregamos plataformas de ingeniería listas para ser afinadas por manos expertas."
        slogan="Precisión Milimétrica, Potencia Absoluta"
        badgeColor="primary"
      />
    </div>
  </section>

  <!-- Filtros Rápidos -->
  <div class="max-w-7xl mx-auto px-4 mb-16 flex flex-wrap gap-4 items-center border-b border-white/5 pb-8">
    <span class="text-[10px] uppercase font-bold text-light/30 tracking-widest mr-4">Filtrar por:</span>
    {['TODOS', 'ON-ROAD', 'OFF-ROAD', 'DRIFT', 'MICRO'].map((f) => (
      <button class="px-6 py-2 rounded-full border border-white/10 text-xs font-bold text-light/50 hover:border-primary hover:text-primary transition-all uppercase tracking-widest">
        {f}
      </button>
    ))}
  </div>

  <!-- Grid de Catálogo -->
  <section class="max-w-7xl mx-auto px-4 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {carCats.map((cat) => (
        <CategoryCard {...cat} />
      ))}
    </div>
  </section>

  <!-- Seccion de Soporte -->
  <section class="bg-primary py-24 text-white overflow-hidden relative">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute -right-20 -top-20 text-[20rem] font-bold font-heading italic leading-none select-none">PITSTOP</div>
      </div>
      <div class="max-w-7xl mx-auto px-4 relative z-10">
        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="font-heading text-5xl md:text-6xl font-bold mb-8 uppercase italic leading-none">
              Respaldo <br /> <span class="text-secondary text-glow">Técnico Total</span>
            </h2>
            <p class="text-xl opacity-90 mb-10 font-medium">
              Cada equipo en nuestro catálogo cuenta con stock completo de refacciones originales y servicio técnico especializado en nuestras sedes nacionales.
            </p>
            <div class="flex gap-4">
               <button class="bg-white text-primary font-bold px-8 py-4 rounded-xl uppercase tracking-widest text-xs hover:bg-secondary hover:text-white transition-all">Solicitar Lista Partes</button>
            </div>
          </div>
          <div class="bg-white/10 backdrop-blur-xl border border-white/20 p-12 rounded-3xl">
             <div class="text-xs uppercase font-bold tracking-[0.3em] mb-4 text-secondary">Mantenimiento v2026</div>
             <h3 class="font-heading text-2xl font-bold mb-6">Turbo Care Gold</h3>
             <ul class="space-y-4 text-sm opacity-80 mb-8">
               <li class="flex gap-3"><span>✓</span> Diagnóstico electrónico trimestral</li>
               <li class="flex gap-3"><span>✓</span> Limpieza ultrasónica de rodamientos</li>
               <li class="flex gap-3"><span>✓</span> Calibración de ESC y Giróscopos</li>
             </ul>
             <p class="text-xs opacity-50 uppercase font-bold tracking-widest">Disponible para todas las marcas del catálogo</p>
          </div>
        </div>
      </div>
    </section>

  <!-- Final CTA -->
  <section class="py-24 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-light mb-8 uppercase italic">
          ¿No encuentras el <span class="text-primary">modelo ideal?</span>
        </h2>
        <p class="text-light/60 text-lg mb-12">
          Realizamos importaciones especiales y configuraciones Custom-Build para pilotos pro. Contáctanos para asesoría personalizada.
        </p>
        <a href="/contacto" class="bg-primary hover:bg-primary/90 text-white font-bold px-12 py-5 rounded-xl transition-all uppercase tracking-widest inline-block shadow-lg shadow-primary/20">
          Hablar con un Especialista
        </a>
      </div>
    </section>
</BaseLayout>
