---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CategoryCard from '../../components/CategoryCard.astro';

const droneCats = [
  {
    title: 'FPV Racing Pro',
    category: 'Competencia Speed',
    scale: '5-inch Class',
    description: 'Adrenalina pura en primera persona. Construidos para la máxima agilidad y velocidad en circuitos técnicos. El estándar de la Liga Nacional FPV.',
    image: 'https://images.unsplash.com/photo-1527977966376-1c841cf93ad2?auto=format&fit=crop&q=80',
    specs: ['160+ KM/H Top', 'Frame Carbono 5"', 'Latencia < 20ms', 'AFAC: Micro UAV']
  },
  {
    title: 'Cinewhoop Cinema',
    category: 'Producción Audiovisual',
    scale: '3-inch Duct',
    description: 'Capturas cinematográficas imposibles. Drones con hélices protegidas para vuelos seguros en interiores y cerca de personas. Calidad 4K/60fps.',
    image: 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&q=80',
    specs: ['Hélices Protegidas', '4K / 60fps HDR', 'Vuelo Indoor Pro', 'AFAC: Micro UAV']
  },
  {
    title: 'Digital Cinema O3',
    category: 'High-End FPV',
    scale: 'Middle Range',
    description: 'La revolución digital en tus ojos. Equipados con el sistema DJI O3 para una transmisión de video cristalina y un rango de operación extendido.',
    image: 'https://images.unsplash.com/photo-1473960104312-3273ed4bb08a?auto=format&fit=crop&q=80',
    specs: ['Transmisión O3 HD', 'Rango 10KM (FCC)', 'GPS Rescue Alt.', 'AFAC: Micro UAV']
  },
  {
    title: 'Mini / Ultralight',
    category: 'Libertad de Vuelo',
    scale: 'Sub-250g',
    description: 'Máximo rendimiento sin complicaciones legales. Drones de menos de 250g que no requieren registro ante AFAC para uso recreativo en México.',
    image: 'https://images.unsplash.com/photo-1521749831539-40cd57902d5e?auto=format&fit=crop&q=80',
    specs: ['Peso < 250g', 'Sin Registro AFAC', 'Autonomía 30min', 'Grabación 4K']
  },
  {
    title: 'Long Range / Explorer',
    category: 'Exploración Total',
    scale: '7-inch Class',
    description: 'Ingeniería diseñada para largas distancias. Marcos optimizados para eficiencia energética y sistemas de navegación GPS avanzada para retorno seguro.',
    image: 'https://images.unsplash.com/photo-1506947411487-a56738267384?auto=format&fit=crop&q=80',
    specs: ['Vuelo 45min+', 'Navegación GPS', 'Enlace 20KM+', 'AFAC: Ligero UAV']
  },
  {
    title: 'Enterprise / Industrial',
    category: 'Soluciones B2B',
    scale: 'Industrial Scale',
    description: 'Herramientas de precisión para la industria mexicana. Inspección térmica, seguridad y mapeo fotogramétrico con sensores de alta tecnología.',
    image: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&q=80',
    specs: ['Sensor Térmico', 'Zoom Óptico 30x', 'Protección IP45', 'AFAC: Ligero UAV']
  }
];
---

<BaseLayout 
  title="Catálogo de Drones Pro | Turbo Racing México"
  description="División aérea de alta tecnología. Drones FPV, cinematográficos e industriales. Cumplimiento AFAC y soporte especializado en México."
>
  <!-- Hero Drones -->
  <section class="pt-32 pb-16 px-4 bg-dark">
    <div class="max-w-7xl mx-auto">
      <SectionHeader 
        badge="Drones Pro & FPV"
        title="El Aire es el Límite"
        p1="Llevamos la perspectiva aérea a nuevas alturas. Nuestra selección de drones profesionales está diseñada para ofrecer el máximo rendimiento en racing, cine e inspección técnica."
        p2="Todos nuestros equipos cumplen con los estándares de la AFAC, garantizando una operación legal y segura para su empresa o proyecto personal."
        slogan="Navegación Precisa, Captura Épica"
        badgeColor="accent"
      />
    </div>
  </section>

  <!-- Banner Normativo AFAC -->
  <section class="max-w-7xl mx-auto px-4 mb-16">
    <div class="bg-primary/10 border border-primary/20 p-8 rounded-3xl flex flex-col md:flex-row items-center gap-8">
      <div class="bg-primary/20 w-16 h-16 rounded-full flex items-center justify-center text-primary text-2xl">🛡️</div>
      <div class="flex-1 text-center md:text-left">
        <h3 class="font-heading text-xl font-bold text-light uppercase mb-2">Compromiso con la Normativa AFAC</h3>
        <p class="text-light/60 text-sm">Nuestros expertos le asesoran en el registro y cumplimiento de la normativa NOM-107-SCT3-2019 para una operación sin contratiempos en territorio mexicano.</p>
      </div>
      <button class="bg-primary text-white font-bold px-8 py-3 rounded-xl uppercase tracking-widest text-xs hover:bg-primary/80 transition-all">Consulte Regulaciones</button>
    </div>
  </section>

  <!-- Grid de Catálogo -->
  <section class="max-w-7xl mx-auto px-4 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {droneCats.map((cat) => (
        <CategoryCard {...cat} />
      ))}
    </div>
  </section>

  <!-- Seccion de Flota Enterprise -->
  <section class="bg-secondary px-4 py-24 relative overflow-hidden">
     <div class="absolute inset-0 opacity-5">
        <div class="absolute -left-20 -top-20 text-[20rem] font-bold font-heading italic leading-none select-none">SKYEYE</div>
     </div>
     <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="order-2 lg:order-1">
                <img 
                    src="https://images.unsplash.com/photo-1521749831539-40cd57902d5e?auto=format&fit=crop&q=80" 
                    alt="Industrial Drone Inspection" 
                    class="rounded-[3rem] border border-white/5 shadow-2xl"
                />
            </div>
            <div class="order-1 lg:order-2">
                <SectionHeader 
                    badge="B2B Solutions"
                    title="Inteligencia Aérea"
                    p1="Desplegamos drones industriales para inspección de infraestructura, agricultura de precisión y seguridad perimetral. Datos en tiempo real para decisiones estratégicas."
                    p2="Nuestro servicio Enterprise incluye capacitación de pilotos, gestión de permisos y mantenimiento predictivo de la flota."
                    badgeColor="neutral"
                />
                <button class="bg-primary text-white font-bold px-10 py-4 rounded-xl uppercase tracking-widest text-xs shadow-lg hover:scale-105 transition-all">Cotizar Consultoría de Flota</button>
            </div>
        </div>
     </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-light mb-8 uppercase italic">
            ¿Buscas una toma <span class="text-primary text-glow">imposible?</span>
        </h2>
        <p class="text-light/60 text-lg mb-12">
          Nuestra división de Cinewhoop está lista para volar donde nadie más se atreve. Desde tomas indoor precision hasta exteriores extremos.
        </p>
        <a href="/contacto" class="bg-primary hover:bg-primary/90 text-white font-bold px-12 py-5 rounded-xl transition-all uppercase tracking-widest inline-block shadow-lg shadow-primary/20">
          Hablar con el Flight Lead
        </a>
      </div>
    </section>
</BaseLayout>
