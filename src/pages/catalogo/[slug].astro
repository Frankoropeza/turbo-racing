---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SectionHeader from '@components/SectionHeader.astro';
import CategoryCard from '@components/CategoryCard.astro';
import Boton from '@components/Boton.astro';
import CtaFinal from '@components/CtaFinal.astro';
import type { Migaja } from '@lib/seo';
import { conAcento } from '@lib/texto';

export async function getStaticPaths() {
  const paginas = await getCollection('catalogo');
  return paginas.map((pagina) => ({ params: { slug: pagina.id }, props: { pagina } }));
}

interface Props {
  pagina: CollectionEntry<'catalogo'>;
}

const { pagina } = Astro.props;
const d = pagina.data;
const { Content } = await render(pagina);
const path = `/catalogo/${pagina.id}/`;
const categorias = (await getCollection('categorias', ({ data }) => data.linea === d.linea)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const slug = (id: string) => id.split('/').pop()!;
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: d.title, url: path },
];
const otro = d.linea === 'carros-rc' ? { href: '/catalogo/drones-pro/', label: 'Ver catálogo de drones' } : { href: '/catalogo/carros-rc/', label: 'Ver catálogo de carros RC' };
---

<BaseLayout
  seo={{
    tipo: 'catalogo',
    title: d.title,
    seoTitle: d.seoTitle,
    description: d.description,
    path,
    image: categorias[0]?.data.imagen.src,
    migas,
    items: categorias.map((c) => ({ nombre: c.data.title, url: `${path}#${slug(c.id)}` })),
  }}
>
  <Breadcrumbs migas={migas} />

  <section class="contenedor pt-10 md:pt-16">
    <SectionHeader {...d.encabezado} nivel="h1">
      <Content />
    </SectionHeader>

    {d.aviso && (
      <aside class="mb-12 grid gap-4 rounded-2xl bg-paper p-6 md:grid-cols-12 md:items-center md:p-8">
        <div class="md:col-span-9">
          <h2 class="text-base font-medium text-ink">{d.aviso.titulo}</h2>
          <p class="mt-1 text-sm leading-relaxed text-muted">{d.aviso.texto}</p>
        </div>
        <div class="md:col-span-3 md:justify-self-end">
          <Boton href={d.aviso.enlace.href} estilo="contorno">{d.aviso.enlace.label}</Boton>
        </div>
      </aside>
    )}

    {d.filtros && (
      <div class="mb-10 flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar categorías">
        <span class="mr-2 text-sm text-muted">Filtrar:</span>
        {d.filtros.map((f, i) => (
          <button
            type="button"
            data-filtro={f.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filtro rounded-full border border-line px-4 py-1.5 text-sm text-muted transition-colors hover:border-ink hover:text-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white"
          >
            {f.label}
          </button>
        ))}
      </div>
    )}
  </section>

  <section class="contenedor" aria-labelledby="titulo-categorias">
    <h2 id="titulo-categorias" class="sr-only">Categorías</h2>
    <div id="grid-categorias" class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {categorias.map((cat, i) => (
        <CategoryCard categoria={cat} href="/contacto/?servicio=catalogo" ctaLabel="Cotizar esta gama" prioridad={i < 3} />
      ))}
    </div>
  </section>

  {d.bloque && (
    <section class="contenedor mt-24 md:mt-32">
      <div class="grid gap-10 border-t border-line pt-8 md:grid-cols-12 md:items-start">
        <div class="md:col-span-6">
          {d.bloque.badge && <p class="etiqueta mb-5">{d.bloque.badge}</p>}
          <h2 class="text-3xl font-medium leading-[1.05] tracking-display text-ink md:text-5xl" set:html={conAcento(d.bloque.titulo)} />
          <div class="mt-6 space-y-4 text-base leading-relaxed text-muted">
            {d.bloque.parrafos.map((p) => <p>{p}</p>)}
          </div>
          <div class="mt-8"><Boton href={d.bloque.boton.href} estilo={d.bloque.boton.estilo}>{d.bloque.boton.label}</Boton></div>
        </div>
        <div class="md:col-span-5 md:col-start-8">
          {d.bloque.tarjeta && (
            <div class="rounded-2xl bg-paper p-8 md:p-10">
              <p class="etiqueta">{d.bloque.tarjeta.etiqueta}</p>
              <h3 class="mt-4 text-2xl font-medium tracking-tight text-ink">{d.bloque.tarjeta.titulo}</h3>
              <ul class="mt-6 space-y-3 border-t border-line pt-6 text-sm text-muted">
                {d.bloque.tarjeta.lista.map((item) => <li class="flex gap-2"><span class="text-primary-strong" aria-hidden="true">—</span>{item}</li>)}
              </ul>
              <p class="mt-6 text-xs text-muted">{d.bloque.tarjeta.nota}</p>
            </div>
          )}
          {d.bloque.imagen && (
            <div class="overflow-hidden rounded-2xl bg-paper">
              <Image src={d.bloque.imagen} alt={d.bloque.alt ?? ''} widths={[480, 768, 1024]} sizes="(min-width: 1024px) 480px, 100vw" class="aspect-[4/3] w-full object-cover" />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <div class="contenedor mt-16"><a href={otro.href} class="enlace">{otro.label} <span aria-hidden="true">→</span></a></div>

  <CtaFinal {...d.cta} />
</BaseLayout>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('.filtro');
  const tarjetas = document.querySelectorAll<HTMLElement>('#grid-categorias [data-tipo]');

  botones.forEach((boton) => {
    boton.addEventListener('click', () => {
      const filtro = boton.dataset.filtro;
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
      tarjetas.forEach((t) => {
        t.classList.toggle('hidden', !(filtro === 'todos' || t.dataset.tipo === filtro));
      });
    });
  });
</script>
