---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const familyExperiences = [
  {
    title: "Eco-Rally Familiar",
    description: "Recorridos guiados en parques naturales con drones de exploración y camionetas RC de alto torque.",
    icon: "🌲"
  },
  {
    title: "Día de Pista (Arrendamiento)",
    description: "Renta de equipos profesionales por sesión. No necesitas tener tu propio auto para empezar el hobby.",
    icon: "🏁"
  },
  {
    title: "Workshops de Ensamblaje",
    description: "Aprende mecánica electrónica básica en talleres de fin de semana para padres e hijos.",
    icon: "🔧"
  },
  {
    title: "Safari Fotográfico FPV",
    description: "Usa nuestros drones cinematográficos para capturar los mejores paisajes desde una perspectiva única.",
    icon: "📸"
  }
];
---

<BaseLayout 
  title="Family Adrenaline | Experiencias de Radio Control en Familia"
  description="El mejor plan de fin de semana en México. Diversión familiar con drones y autos RC de alta gama bajo supervisión experta."
>
  <!-- Hero Familias -->
  <section class="relative pt-32 pb-24 overflow-hidden bg-dark">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1536640712247-c39eb06c4291?auto=format&fit=crop&q=80" 
        alt="Family RC Fun" 
        class="w-full h-full object-cover opacity-30 saturate-150"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-dark"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 text-center lg:text-left">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full border border-orange-500/20 bg-orange-500/5 text-orange-500 text-[10px] font-bold uppercase tracking-[0.4em] mb-6">
            Family Experience
          </span>
          <h1 class="font-heading text-5xl md:text-7xl font-bold text-light mb-8 uppercase italic leading-[0.9] tracking-tighter">
            Turbo <br /> <span class="text-secondary text-glow">Families</span>
          </h1>
          <p class="text-xl text-light/80 max-w-xl mb-12 font-medium leading-relaxed">
            Creamos recuerdos de alta velocidad. Conecte con su familia a través de la tecnología y la aventura al aire libre.
          </p>
          <div class="flex flex-wrap gap-6 justify-center lg:justify-start">
            <button class="bg-secondary hover:bg-secondary/90 text-white font-bold px-10 py-4 rounded-xl transition-all uppercase tracking-widest text-sm shadow-xl shadow-secondary/20">
              Ver Sedes
            </button>
            <button class="border border-white/10 hover:bg-white/5 text-white font-bold px-10 py-4 rounded-xl transition-all uppercase tracking-widest text-sm">
              Paquetes Grupales
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seccion Experiencias -->
  <section class="py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <SectionHeader 
        badge="Diversión Segura"
        title="Momentos de Adrenalina"
        p1="En Turbo Racing creemos que el hobby es el puente perfecto para la convivencia. Nuestras experiencias familiares están diseñadas para ser seguras, educativas y extremadamente divertidas para todas las edades."
        p2="Olvídese de las pantallas tradicionales. Es momento de sentir el torque real en las manos y la libertad del vuelo en los ojos."
        badgeColor="accent"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {familyExperiences.map((exp) => (
          <div class="bg-secondary/30 border border-white/5 p-8 rounded-3xl hover:border-secondary/50 transition-all hover:-translate-y-2 group">
            <div class="text-5xl mb-6">{exp.icon}</div>
            <h3 class="font-heading text-xl font-bold text-light mb-4 uppercase italic tracking-tight">{exp.title}</h3>
            <p class="text-light/50 text-sm leading-relaxed">{exp.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Imagen Inspiradora -->
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="relative aspect-[21/9] rounded-[3rem] overflow-hidden border border-white/5">
      <img 
        src="https://images.unsplash.com/photo-1594787318286-3d835c1d207f?auto=format&fit=crop&q=80" 
        alt="Outdoor Experience" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-dark/40 flex items-center justify-center text-center px-4">
        <h2 class="font-heading text-3xl md:text-5xl font-bold text-white uppercase italic tracking-tighter">
          Adrenalina real para la <br /> <span class="text-secondary text-glow">Nueva Generación</span>
        </h2>
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-24 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-light mb-8 uppercase italic">
        ¿Qué harás el <span class="text-secondary">próximo domingo?</span>
      </h2>
      <p class="text-light/60 text-lg mb-12">
        Súmate a nuestras excursiones en CDMX (La Mexicana), Monterrey (La Huasteca) y Guadalajara (Puerta de Hierro).
      </p>
      <a href="/contacto" class="bg-secondary hover:bg-secondary/90 text-white font-bold px-12 py-5 rounded-xl transition-all uppercase tracking-widest inline-block shadow-lg shadow-secondary/20">
        Reservar Lugar Familiar
      </a>
    </div>
  </section>
</BaseLayout>
