---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeader from '@components/SectionHeader.astro';
import CtaFinal from '@components/CtaFinal.astro';
import type { Migaja } from '@lib/seo';
import { conAcento, numero } from '@lib/texto';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({ params: { slug: servicio.id }, props: { servicio } }));
}

interface Props {
  servicio: CollectionEntry<'servicios'>;
}

const { servicio } = Astro.props;
const d = servicio.data;
const { Content } = await render(servicio);
const path = `/servicios/${servicio.id}/`;
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: d.resumen.nombre, url: path },
];
const otros = (await getCollection('servicios')).filter((s) => s.id !== servicio.id).sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout
  seo={{
    tipo: 'servicio',
    title: d.title,
    seoTitle: d.seoTitle,
    description: d.description,
    path,
    image: d.hero.imagen.src,
    migas,
    servicio: { nombre: d.resumen.nombre, tipo: d.seoTitle },
  }}
>
  <Breadcrumbs migas={migas} />
  <PageHero {...d.hero} />

  <section class="contenedor mt-24 md:mt-32">
    <SectionHeader badge={d.seccion.badge} title={d.seccion.title} slogan={d.seccion.slogan} numero="01">
      <Content />
    </SectionHeader>

    <ol class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {d.caracteristicas.map((f, i) => (
        <li class="bg-white p-8">
          <span class="text-xs text-muted">{numero(i + 1)}</span>
          <h3 class="mt-6 text-lg font-medium tracking-tight text-ink">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{f.description}</p>
        </li>
      ))}
    </ol>
  </section>

  {d.bloqueImagen && (
    <section class="contenedor mt-24 md:mt-32">
      <figure>
        <div class="overflow-hidden rounded-2xl bg-paper">
          <Image src={d.bloqueImagen.imagen} alt={d.bloqueImagen.alt} widths={[640, 1024, 1440, 1920]} sizes="100vw" class="aspect-[4/3] max-h-[75vh] w-full object-cover md:aspect-[21/9]" />
        </div>
        <figcaption class="mt-6 max-w-3xl text-2xl font-medium leading-snug tracking-tight text-ink md:text-4xl" set:html={conAcento(d.bloqueImagen.titulo)} />
      </figure>
    </section>
  )}

  <section class="contenedor mt-24 md:mt-32">
    <div class="border-t border-line pt-8">
      <p class="etiqueta mb-6">Otros servicios</p>
      <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2">
        {otros.map((o) => (
          <li class="bg-white">
            <a href={`/servicios/${o.id}/`} class="group flex h-full items-center justify-between gap-6 p-8 transition-colors hover:bg-paper">
              <span>
                <span class="block text-lg font-medium text-ink">{o.data.resumen.nombre}</span>
                <span class="mt-1 block text-sm text-muted">{o.data.resumen.texto}</span>
              </span>
              <span aria-hidden="true" class="text-muted transition-transform group-hover:translate-x-1 group-hover:text-ink">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaFinal {...d.cta} />
</BaseLayout>
