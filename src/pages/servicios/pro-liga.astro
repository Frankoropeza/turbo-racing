---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const leagueHighlights = [
  {
    title: "Campeonato Nacional de Drift",
    description: "Competencias puntuadas por jueces certificados sobre técnica, ángulo y velocidad.",
    icon: "🔥"
  },
  {
    title: "Trofeo FPV Drone Racing",
    description: "Carreras de obstáculos a 140km/h con telemetría profesional MyLaps.",
    icon: "⚡"
  },
  {
    title: "Ranking Local MX",
    description: "Posiciónate en el ranking oficial de pilotos de México y accede a patrocinios de marcas.",
    icon: "🏆"
  },
  {
    title: "Clínicas de Ingeniería",
    description: "Talleres avanzados de tuning electrónico y aerodinámica para mejorar tus tiempos.",
    icon: "📐"
  }
];
---

<BaseLayout 
  title="Pro Liga México | Competición Profesional de RC y FPV"
  description="La arena de los expertos. Únase a la liga nacional de pilotos de radio control y drones FPV en México. Competencias oficiales y ranking nacional."
>
  <!-- Hero Pro Liga -->
  <section class="relative pt-32 pb-24 overflow-hidden bg-dark">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1547744152-14d985cb937f?auto=format&fit=crop&q=80" 
        alt="Pro Racing League" 
        class="w-full h-full object-cover opacity-30 grayscale"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-dark via-dark/80 to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 text-center lg:text-left">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full border border-primary/40 bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-[0.4em] mb-6">
            Elite Performance
          </span>
          <h1 class="font-heading text-5xl md:text-7xl font-bold text-light mb-8 uppercase italic leading-[0.9] tracking-tighter">
            Pro Liga <br /> <span class="text-glow">México</span>
          </h1>
          <p class="text-xl text-light/50 max-w-xl mb-12 font-medium leading-relaxed">
            Donde las milésimas de segundo separan a los entusiastas de las leyendas. La plataforma definitiva para la competición profesional en México.
          </p>
          <div class="flex flex-wrap gap-6 justify-center lg:justify-start">
            <button class="bg-primary hover:bg-primary/90 text-white font-bold px-10 py-4 rounded-xl transition-all uppercase tracking-widest text-sm shadow-xl shadow-primary/20">
              Inscribirse a la Liga
            </button>
            <button class="border border-white/10 hover:bg-white/5 text-white font-bold px-10 py-4 rounded-xl transition-all uppercase tracking-widest text-sm">
              Ver Resultados 2026
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seccion Competicion -->
  <section class="py-24 px-4 bg-secondary/10">
    <div class="max-w-7xl mx-auto">
      <SectionHeader 
        badge="Reglamento Nacional"
        title="Arena de Expertos"
        p1="La Pro Liga México de Turbo Racing es un ecosistema de alta competencia diseñado para elevar el nivel técnico de los pilotos. Nuestras reglas están basadas en estándares internacionales de la FAI."
        p2="No solo competimos por trofeos, competimos por la perfección técnica en cada curva y cada despegue."
        badgeColor="neutral"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {leagueHighlights.map((hl) => (
          <div class="bg-dark/50 border border-white/5 p-8 rounded-3xl hover:border-primary/50 transition-all group">
            <div class="text-4xl mb-6">{hl.icon}</div>
            <h3 class="font-heading text-xl font-bold text-light mb-4 uppercase italic tracking-tight">{hl.title}</h3>
            <p class="text-light/50 text-sm leading-relaxed">{hl.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ranking Mockup -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto bg-secondary/30 border border-white/5 rounded-3xl p-12 overflow-hidden relative">
      <div class="absolute -right-20 -bottom-20 text-[10rem] font-heading font-extrabold opacity-5 italic select-none">RANKING</div>
      <h2 class="font-heading text-3xl font-bold text-light uppercase mb-8 italic">Top 3 Pilotos <span class="text-primary">México 2026</span></h2>
      <div class="space-y-4">
        {[
          { pos: '01', name: 'ALEJANDRO "REDO" RIVERA', pts: '4,850', team: 'TURBO DRONES CDMX' },
          { pos: '02', name: 'SOFÍA "BREEZE" GARCÍA', pts: '4,720', team: 'MONTERREY DRIFT TEAM' },
          { pos: '03', name: 'RICARDO "VOLT" HERRERA', pts: '4,580', team: 'GALAXY RACING GDL' },
        ].map((p) => (
          <div class="flex items-center justify-between p-6 bg-white/5 rounded-xl hover:bg-white/10 transition-all border border-white/5">
            <div class="flex items-center gap-6">
              <span class="font-heading text-2xl font-bold text-primary">{p.pos}</span>
              <div>
                <div class="font-bold text-light text-lg uppercase">{p.name}</div>
                <div class="text-[10px] text-light/30 uppercase font-bold tracking-widest">{p.team}</div>
              </div>
            </div>
            <div class="text-right">
              <div class="font-heading text-xl font-bold text-light">{p.pts}</div>
              <div class="text-[9px] text-light/30 uppercase font-bold tracking-widest pt-1">Puntos</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-24 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-light mb-8 uppercase italic">
        Demuestra tu <span class="text-primary">Talento Real</span>
      </h2>
      <p class="text-light/60 text-lg mb-12">
        Inscripciones abiertas para el Split de Verano en CDMX, Monterrey y Guadalajara. Cupo limitado por categoría técnica.
      </p>
      <a href="/contacto" class="bg-primary hover:bg-primary/90 text-white font-bold px-12 py-5 rounded-xl transition-all uppercase tracking-widest inline-block shadow-lg shadow-primary/20">
        Unirse a la Liga Hoy
      </a>
    </div>
  </section>
</BaseLayout>
