---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const features = [
  {
    title: "Team Building de Alto Impacto",
    description: "Fomentamos la comunicación y el liderazgo a través de competencias de relevos y retos técnicos de precisión con drones y autos RC.",
    icon: "🤝"
  },
  {
    title: "Branding Personalizado",
    description: "Personalizamos los vehículos y la pista con la identidad visual de su empresa para una experiencia de marca total.",
    icon: "🎨"
  },
  {
    title: "Logística Nacional",
    description: "Operamos en CDMX, Monterrey, Guadalajara y cualquier punto de la República Mexicana con equipo propio.",
    icon: "🇲🇽"
  },
  {
    title: "Aftermovies 4K & Telemetría",
    description: "Entrega de contenido profesional del evento y análisis de datos de carrera en tiempo real para los participantes.",
    icon: "🎥"
  }
];
---

<BaseLayout 
  title="Turbo Corporate | Team Building y Eventos B2B en México"
  description="Llevamos la innovación tecnológica a su empresa. Eventos corporativos con drones y radio control diseñados para el liderazgo y la integración."
>
  <!-- Hero Corporativo -->
  <section class="relative pt-32 pb-24 overflow-hidden bg-dark">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&q=80" 
        alt="Corporate Team Building" 
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-dark via-transparent to-dark"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 text-center lg:text-left">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full border border-primary/20 bg-primary/5 text-primary text-[10px] font-bold uppercase tracking-[0.4em] mb-6">
            B2B Solutions
          </span>
          <h1 class="font-heading text-5xl md:text-7xl font-bold text-light mb-8 uppercase italic leading-[0.9] tracking-tighter">
            Turbo <br /> <span class="text-primary text-glow">Corporate</span>
          </h1>
          <p class="text-xl text-light/60 max-w-xl mb-12 font-medium leading-relaxed">
            Transformamos la integración empresarial en una experiencia de alta velocidad. Ingeniería, estrategia y adrenalina al servicio de su capital humano.
          </p>
          <div class="flex flex-wrap gap-6 justify-center lg:justify-start">
            <button class="bg-primary hover:bg-primary/90 text-white font-bold px-10 py-4 rounded-xl transition-all uppercase tracking-widest text-sm shadow-xl shadow-primary/20">
              Solicitar Dossier
            </button>
            <button class="border border-white/10 hover:bg-white/5 text-white font-bold px-10 py-4 rounded-xl transition-all uppercase tracking-widest text-sm">
              Ver Casos de Éxito
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Características -->
  <section class="py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <SectionHeader 
        badge="Valor Agregado"
        title="Ingeniería Humana"
        p1="Nuestros eventos no son simples juegos; son dinámicas de ingeniería diseñadas para reflejar los retos de la industria moderna: precisión, tiempos de respuesta y coordinación de equipo."
        p2="Utilizamos tecnología de punta para crear un entorno competitivo sano que fortalece los lazos profesionales y la identidad corporativa."
        badgeColor="neutral"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map((f) => (
          <div class="bg-secondary/30 border border-white/5 p-8 rounded-3xl hover:border-primary/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform inline-block">{f.icon}</div>
            <h3 class="font-heading text-xl font-bold text-light mb-4 uppercase italic tracking-tight">{f.title}</h3>
            <p class="text-light/50 text-sm leading-relaxed">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Seccion de Confianza -->
  <section class="bg-secondary/20 py-24 border-y border-white/5">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-light uppercase mb-12 italic">
        Confiado por los <span class="text-primary">Líderes de la Industria</span>
      </h2>
      <div class="flex flex-wrap justify-center gap-12 opacity-30 grayscale hover:grayscale-0 transition-all duration-700">
        <!-- Logo placeholders (simulando B2B tech/industrial) -->
        <div class="text-2xl font-bold tracking-tighter">VOLVO</div>
        <div class="text-2xl font-bold tracking-tighter">SAMSUNG</div>
        <div class="text-2xl font-bold tracking-tighter">DHL</div>
        <div class="text-2xl font-bold tracking-tighter">CEMEX</div>
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-24 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-light mb-8 uppercase italic">
        ¿Listo para <span class="text-primary">acelerar</span> tu equipo?
      </h2>
      <p class="text-light/60 text-lg mb-12">
        Agende una sesión de consultoría técnica hoy mismo. Operamos en CDMX, Monterrey y Guadalajara con despliegue inmediato.
      </p>
      <a href="/contacto" class="bg-primary hover:bg-primary/90 text-white font-bold px-12 py-5 rounded-xl transition-all uppercase tracking-widest inline-block shadow-lg shadow-primary/20">
        Cotizar Evento Corporativo
      </a>
    </div>
  </section>
</BaseLayout>
