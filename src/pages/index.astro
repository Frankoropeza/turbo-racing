---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickNav from '@components/QuickNav.astro';
import SectionHeader from '@components/SectionHeader.astro';
import CategoryCard from '@components/CategoryCard.astro';
import ArticleCard from '@components/ArticleCard.astro';
import Methodology from '@components/Methodology.astro';
import Boton from '@components/Boton.astro';
import CtaFinal from '@components/CtaFinal.astro';
import { fechaMx } from '@lib/seo';
import { conAcento, numero } from '@lib/texto';

const pagina = await getEntry('paginas', 'inicio');
if (!pagina) throw new Error('Falta src/content/paginas/inicio.md');
const { hero, accesos = [], secciones = {}, porque, proceso, cta } = pagina.data;
if (!hero) throw new Error('inicio.md requiere hero');
const { Content: TextoHero } = await render(pagina);

const porOrden = <T extends { data: { orden: number } }>(a: T, b: T) => a.data.orden - b.data.orden;
const categorias = await getCollection('categorias');
const drones = categorias.filter((c) => c.data.linea === 'drones-pro').sort(porOrden);
const carros = categorias.filter((c) => c.data.linea === 'carros-rc').sort(porOrden);
const servicios = (await getCollection('servicios')).sort(porOrden);

const hoy = new Date();
// La colección de eventos puede estar vacía: solo se consulta si hay archivos (evita el aviso de Astro).
const hayEventos = Object.keys(import.meta.glob('../content/eventos/**/*.{md,mdx}')).length > 0;
const eventos = hayEventos
  ? (await getCollection('eventos', ({ data }) => !data.draft && data.date >= hoy)).sort(
      (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
    )
  : [];
const noticias = (await getCollection('noticias', ({ data }) => !data.draft))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);

const slug = (id: string) => id.split('/').pop();
let n = 0;
const sig = () => numero(++n);
---

<BaseLayout seo={{ tipo: 'inicio', title: pagina.data.title, seoTitle: pagina.data.seoTitle, description: pagina.data.description, path: '/' }}>
  <!-- Hero -->
  <section class="contenedor pt-12 md:pt-20">
    <p class="etiqueta mb-6">{hero.badge}</p>
    <h1 class="max-w-[16ch] text-balance text-5xl font-medium leading-[1.0] tracking-display text-ink md:text-7xl lg:text-8xl 2xl:text-9xl" set:html={conAcento(hero.titulo)} />
    <div class="mt-10 grid gap-8 md:grid-cols-12">
      <div class="max-w-2xl space-y-4 text-base leading-relaxed text-muted md:col-span-6 [&_strong]:font-medium [&_strong]:text-ink">
        <TextoHero />
      </div>
      <div class="flex flex-wrap items-start gap-3 md:col-span-5 md:col-start-8 md:justify-end">
        {hero.botones.map((b) => <Boton href={b.href} estilo={b.estilo}>{b.label}</Boton>)}
      </div>
    </div>
    <div class="mt-12 overflow-hidden rounded-2xl bg-paper md:mt-16">
      <Image
        src={hero.imagen}
        alt={hero.alt}
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] max-h-[75vh] w-full object-cover md:aspect-[21/9]"
      />
    </div>
    <p class="mt-3 text-xs text-muted">{hero.tagline}</p>
  </section>

  <QuickNav accesos={accesos} />

  <!-- Servicios -->
  <section id="experiencias" class="contenedor mt-24 scroll-mt-20 md:mt-32">
    {secciones.experiencias && <SectionHeader {...secciones.experiencias} numero={sig()} />}
    <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3">
      {servicios.map((s) => (
        <article class="flex flex-col bg-white p-8">
          <h3 class="text-xl font-medium tracking-tight text-ink">{s.data.resumen.nombre}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{s.data.resumen.texto}</p>
          <ul class="mt-6 flex-1 space-y-2 border-t border-line pt-6 text-sm text-muted">
            {s.data.resumen.puntos.map((p) => (
              <li class="flex gap-2"><span class="text-primary-strong" aria-hidden="true">—</span>{p}</li>
            ))}
          </ul>
          <a href={`/servicios/${s.id}/`} class="enlace mt-8 self-start">
            {s.data.resumen.enlace}<span class="sr-only">: {s.data.resumen.nombre}</span> <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- Drones -->
  {secciones.drones && (
    <section id="drones-pro" class="contenedor mt-24 md:mt-32">
      <SectionHeader {...secciones.drones} numero={sig()} />
      <div class="grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-3">
        {drones.map((cat) => <CategoryCard categoria={cat} variante="compacta" href={`/catalogo/drones-pro/#${slug(cat.id)}`} />)}
      </div>
      <a href="/catalogo/drones-pro/" class="enlace mt-10">Ver catálogo de drones <span aria-hidden="true">→</span></a>
    </section>
  )}

  <!-- Carros RC -->
  {secciones.carros && (
    <section id="carros-rc" class="contenedor mt-24 md:mt-32">
      <SectionHeader {...secciones.carros} numero={sig()} />
      <div class="grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-3">
        {carros.map((cat) => <CategoryCard categoria={cat} variante="compacta" href={`/catalogo/carros-rc/#${slug(cat.id)}`} />)}
      </div>
      <a href="/catalogo/carros-rc/" class="enlace mt-10">Ver catálogo de carros RC <span aria-hidden="true">→</span></a>
    </section>
  )}

  <!-- Por qué Turbo Racing -->
  {porque && (
    <section class="contenedor mt-24 md:mt-32">
      <div class="grid gap-10 border-t border-line pt-8 md:grid-cols-12">
        <div class="md:col-span-6">
          <p class="etiqueta mb-5"><span class="text-ink">{sig()}</span> — Nosotros</p>
          <h2 class="text-3xl font-medium leading-[1.05] tracking-display text-ink md:text-5xl" set:html={conAcento(porque.titulo)} />
          <p class="mt-6 max-w-md text-base leading-relaxed text-muted">{porque.texto}</p>
        </div>
        <div class="rounded-2xl bg-paper p-8 md:col-span-5 md:col-start-8 md:p-10">
          <h3 class="text-xl font-medium tracking-tight text-ink">{porque.tarjeta.titulo}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{porque.tarjeta.texto}</p>
          <div class="mt-6"><Boton href={porque.tarjeta.boton.href} estilo="contorno">{porque.tarjeta.boton.label}</Boton></div>
        </div>
      </div>
    </section>
  )}

  {proceso && <Methodology badge={proceso.badge} titulo={proceso.titulo} pasos={proceso.pasos} numeroSeccion={sig()} />}

  <!-- Próximos eventos: solo con fechas futuras publicadas -->
  {eventos.length > 0 && secciones.eventos && (
    <section id="eventos" class="contenedor mt-24 md:mt-32">
      <SectionHeader {...secciones.eventos} numero={sig()} />
      <ul class="border-t border-line">
        {eventos.map((ev) => (
          <li class="grid items-center gap-4 border-b border-line py-6 md:grid-cols-12">
            <time datetime={ev.data.date.toISOString()} class="text-sm text-muted md:col-span-2">{fechaMx(ev.data.date, 'short')}</time>
            <h3 class="text-lg font-medium text-ink md:col-span-5">{ev.data.title}</h3>
            <p class="text-sm text-muted md:col-span-3">{ev.data.ciudad} · {ev.data.sede}</p>
            <a href={ev.data.registroUrl ?? '/contacto/?servicio=pro-liga'} class="enlace md:col-span-2 md:justify-self-end">Reservar <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Noticias -->
  {noticias.length > 0 && secciones.noticias && (
    <section id="ultimas-noticias" class="contenedor mt-24 md:mt-32">
      <SectionHeader {...secciones.noticias} numero={sig()} />
      <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {noticias.map((nt) => <ArticleCard noticia={nt} />)}
      </div>
    </section>
  )}

  {cta && <CtaFinal {...cta} />}
</BaseLayout>
