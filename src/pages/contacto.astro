---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ContactForm from '@components/ContactForm.astro';
import { site, whatsappUrl, redesActivas } from '@config/site';
import type { Migaja } from '@lib/seo';

const pagina = await getEntry('paginas', 'contacto');
if (!pagina) throw new Error('Falta src/content/paginas/contacto.md');
const { Content } = await render(pagina);
const c = site.contacto;
const wa = whatsappUrl();
const redes = redesActivas();
const hayCanales = Boolean(wa || c.email || c.telefono || redes.length || c.zonas.length);
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: 'Contacto', url: '/contacto/' },
];
---

<BaseLayout seo={{ tipo: 'contacto', title: pagina.data.title, seoTitle: pagina.data.seoTitle, description: pagina.data.description, path: '/contacto/', migas }}>
  <Breadcrumbs migas={migas} />

  <section class="pt-32 pb-8 px-4 bg-secondary/10">
    <div class="max-w-7xl mx-auto">
      <SectionHeader badge={pagina.data.badge ?? 'Contacto'} title={pagina.data.title} nivel="h1" badgeColor="primary">
        <Content />
      </SectionHeader>
    </div>
  </section>

  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-5 gap-16">
      <div class={hayCanales ? 'lg:col-span-3' : 'lg:col-span-5 max-w-3xl'}>
        <h2 class="font-heading text-3xl font-bold text-light pb-8 uppercase italic">
          Envía un mensaje <span class="text-primary">al pit lane</span>
        </h2>
        <ContactForm />
      </div>

      {hayCanales && (
        <aside class="lg:col-span-2 bg-secondary/30 border border-white/5 p-10 rounded-[3rem] h-fit" aria-labelledby="canales">
          <h2 id="canales" class="font-heading text-2xl font-bold text-light uppercase mb-8 italic">
            Canales <span class="text-primary">directos</span>
          </h2>
          <dl class="space-y-8">
            {wa && (
              <div>
                <dt class="text-primary font-bold uppercase text-xs tracking-widest mb-2">WhatsApp</dt>
                <dd><a href={wa} target="_blank" rel="noopener noreferrer" class="text-light font-bold hover:text-primary transition-colors">Escríbenos por WhatsApp</a></dd>
              </div>
            )}
            {c.telefono && (
              <div>
                <dt class="text-primary font-bold uppercase text-xs tracking-widest mb-2">Teléfono</dt>
                <dd><a href={`tel:${c.telefono.replace(/[^\d+]/g, '')}`} class="text-light font-bold hover:text-primary transition-colors">{c.telefono}</a></dd>
              </div>
            )}
            {c.email && (
              <div>
                <dt class="text-primary font-bold uppercase text-xs tracking-widest mb-2">Correo</dt>
                <dd><a href={`mailto:${c.email}`} class="text-light font-bold hover:text-primary transition-colors">{c.email}</a></dd>
              </div>
            )}
            {c.zonas.length > 0 && (
              <div>
                <dt class="text-primary font-bold uppercase text-xs tracking-widest mb-2">Cobertura</dt>
                <dd class="text-light/80">{c.zonas.join(' · ')}</dd>
              </div>
            )}
            {c.horario && (
              <div>
                <dt class="text-primary font-bold uppercase text-xs tracking-widest mb-2">Horario</dt>
                <dd class="text-light/80">{c.horario}</dd>
              </div>
            )}
          </dl>
          {redes.length > 0 && (
            <ul class="flex gap-4 pt-8 mt-8 border-t border-white/10" aria-label="Redes sociales">
              {redes.map((r) => (
                <li><a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={r.nombre} class="w-12 h-12 bg-white/5 rounded-full flex items-center justify-center hover:bg-primary-strong transition-all font-bold">{r.abreviatura}</a></li>
              ))}
            </ul>
          )}
        </aside>
      )}
    </div>
  </section>
</BaseLayout>
