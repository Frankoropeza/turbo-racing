---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ContactForm from '@components/ContactForm.astro';
import { site, whatsappUrl, redesActivas } from '@config/site';
import type { Migaja } from '@lib/seo';

const pagina = await getEntry('paginas', 'contacto');
if (!pagina) throw new Error('Falta src/content/paginas/contacto.md');
const { Content } = await render(pagina);
const c = site.contacto;
const wa = whatsappUrl();
const redes = redesActivas();
const hayCanales = Boolean(wa || c.email || c.telefono || redes.length || c.zonas.length);
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: 'Contacto', url: '/contacto/' },
];
---

<BaseLayout seo={{ tipo: 'contacto', title: pagina.data.title, seoTitle: pagina.data.seoTitle, description: pagina.data.description, path: '/contacto/', migas }}>
  <Breadcrumbs migas={migas} />

  <section class="contenedor pt-10 md:pt-16">
    <SectionHeader badge={pagina.data.badge ?? 'Contacto'} title={pagina.data.title} nivel="h1">
      <Content />
    </SectionHeader>

    <div class="grid gap-12 md:grid-cols-12">
      <div class={hayCanales ? 'md:col-span-7' : 'md:col-span-8'}>
        <h2 class="mb-8 text-xl font-medium tracking-tight text-ink">Envía un mensaje</h2>
        <ContactForm />
      </div>

      {hayCanales && (
        <aside class="md:col-span-4 md:col-start-9" aria-labelledby="canales">
          <h2 id="canales" class="mb-6 text-xl font-medium tracking-tight text-ink">Canales directos</h2>
          <dl class="divide-y divide-line border-y border-line text-sm">
            {wa && (
              <div class="flex justify-between gap-4 py-4">
                <dt class="text-muted">WhatsApp</dt>
                <dd><a href={wa} target="_blank" rel="noopener noreferrer" class="enlace">Escribir ↗</a></dd>
              </div>
            )}
            {c.telefono && (
              <div class="flex justify-between gap-4 py-4">
                <dt class="text-muted">Teléfono</dt>
                <dd><a href={`tel:${c.telefono.replace(/[^\d+]/g, '')}`} class="enlace">{c.telefono}</a></dd>
              </div>
            )}
            {c.email && (
              <div class="flex justify-between gap-4 py-4">
                <dt class="text-muted">Correo</dt>
                <dd><a href={`mailto:${c.email}`} class="enlace">{c.email}</a></dd>
              </div>
            )}
            {c.zonas.length > 0 && (
              <div class="flex justify-between gap-4 py-4">
                <dt class="text-muted">Cobertura</dt>
                <dd class="text-right text-ink">{c.zonas.join(', ')}</dd>
              </div>
            )}
            {c.horario && (
              <div class="flex justify-between gap-4 py-4">
                <dt class="text-muted">Horario</dt>
                <dd class="text-right text-ink">{c.horario}</dd>
              </div>
            )}
            {redes.map((r) => (
              <div class="flex justify-between gap-4 py-4">
                <dt class="text-muted">{r.nombre}</dt>
                <dd><a href={r.url} target="_blank" rel="noopener noreferrer" class="enlace">Seguir ↗</a></dd>
              </div>
            ))}
          </dl>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>
