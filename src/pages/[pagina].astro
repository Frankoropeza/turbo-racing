---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { site } from '@config/site';
import { fechaMx, type Migaja } from '@lib/seo';

/** Páginas legales en Markdown (tipo: legal). */
export async function getStaticPaths() {
  const legales = await getCollection('paginas', ({ data }) => data.tipo === 'legal');
  return legales.map((entry) => ({ params: { pagina: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'paginas'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/${entry.id}/`;
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: entry.data.title, url: path },
];
const responsable = site.legal.responsable || site.nombreLegal;
---

<BaseLayout seo={{ tipo: 'legal', title: entry.data.title, description: entry.data.description, path, migas }}>
  <Breadcrumbs migas={migas} />
  <article class="max-w-3xl mx-auto px-4 pt-24 pb-20">
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-light mb-4">{entry.data.title}</h1>
    {entry.data.actualizado && (
      <p class="text-sm text-light/60 mb-10">Última actualización: <time datetime={entry.data.actualizado.toISOString()}>{fechaMx(entry.data.actualizado)}</time></p>
    )}
    <div class="bg-secondary/40 border border-white/10 rounded-2xl p-6 mb-10 text-light/80 text-sm leading-relaxed">
      <p><strong class="text-light">Responsable del tratamiento de tus datos personales:</strong> {responsable}.</p>
      {site.legal.domicilio && <p class="mt-2"><strong class="text-light">Domicilio:</strong> {site.legal.domicilio}.</p>}
    </div>
    <div class="prose prose-invert max-w-none prose-headings:font-heading prose-headings:text-light prose-a:text-primary prose-strong:text-light">
      <Content />
    </div>
  </article>
</BaseLayout>
