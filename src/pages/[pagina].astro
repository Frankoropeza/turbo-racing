---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { site } from '@config/site';
import { fechaMx, type Migaja } from '@lib/seo';

/** Páginas legales en Markdown (tipo: legal). */
export async function getStaticPaths() {
  const legales = await getCollection('paginas', ({ data }) => data.tipo === 'legal');
  return legales.map((entry) => ({ params: { pagina: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'paginas'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/${entry.id}/`;
const migas: Migaja[] = [
  { nombre: 'Inicio', url: '/' },
  { nombre: entry.data.title, url: path },
];
const responsable = site.legal.responsable || site.nombreLegal;
---

<BaseLayout seo={{ tipo: 'legal', title: entry.data.title, description: entry.data.description, path, migas }}>
  <Breadcrumbs migas={migas} />
  <article class="contenedor pt-10 md:pt-16">
    <div class="mx-auto max-w-3xl">
      <p class="etiqueta">Legal</p>
      <h1 class="mt-5 text-4xl font-medium leading-[1.05] tracking-display text-ink md:text-5xl">{entry.data.title}</h1>
      {entry.data.actualizado && (
        <p class="mt-4 text-sm text-muted">Última actualización: <time datetime={entry.data.actualizado.toISOString()}>{fechaMx(entry.data.actualizado)}</time></p>
      )}
      <div class="mt-10 rounded-xl bg-paper p-6 text-sm leading-relaxed text-muted">
        <p><span class="font-medium text-ink">Responsable del tratamiento de tus datos personales:</span> {responsable}.</p>
        {site.legal.domicilio && <p class="mt-2"><span class="font-medium text-ink">Domicilio:</span> {site.legal.domicilio}.</p>}
      </div>
      <div class="prose prose-neutral mt-10 max-w-none prose-headings:font-medium prose-headings:tracking-tight prose-a:text-ink prose-a:underline-offset-4 prose-strong:font-medium">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
