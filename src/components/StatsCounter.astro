---
const stats = [
  { number: '10+', label: 'Años de Experiencia', icon: '🏆' },
  { number: '500+', label: 'Eventos Realizados', icon: '🏁' },
  { number: '1.2k', label: 'Pilotos Registrados', icon: '🎮' },
  { number: '100%', label: 'Seguridad Certificada', icon: '🛡️' },
];
---

<section class="bg-secondary/50 border-y border-white/5 py-16">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((stat) => (
        <div class="text-center group">
          <div class="text-4xl mb-2 grayscale group-hover:grayscale-0 transition-all transform group-hover:scale-110 duration-300">
            {stat.icon}
          </div>
          <div class="font-heading text-4xl md:text-5xl font-bold text-primary mb-1 tracking-tighter">
            {stat.number}
          </div>
          <div class="text-light/40 text-xs md:text-sm uppercase font-bold tracking-widest leading-tight px-4">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
