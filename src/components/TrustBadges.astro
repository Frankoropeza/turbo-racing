---
const badges = [
  { name: 'AFAC Certificada', img: 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png', label: 'Operación Segura' },
  { name: 'NOM-México', img: 'https://cdn-icons-png.flaticon.com/512/1041/1041916.png', label: 'Estándar de Calidad' },
  { name: 'Seguro RC', img: 'https://cdn-icons-png.flaticon.com/512/1162/1162251.png', label: 'Protección Civil' },
  { name: '24/7 Soporte', img: 'https://cdn-icons-png.flaticon.com/512/1067/1067561.png', label: 'Asistencia Técnica' },
];
---

<section class="bg-secondary/30 py-12 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-wrap items-center justify-center gap-12 md:gap-24 opacity-40 hover:opacity-100 transition-opacity">
      {badges.map((badge) => (
        <div class="flex items-center gap-4 group">
          <div class="w-12 h-12 grayscale group-hover:grayscale-0 transition-all transform group-hover:scale-110">
            <img src={badge.img} alt={badge.name} class="w-full h-full object-contain" />
          </div>
          <div class="text-left">
            <div class="text-xs font-bold text-light uppercase tracking-widest">{badge.name}</div>
            <div class="text-[10px] text-light/40 uppercase font-medium">{badge.label}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
