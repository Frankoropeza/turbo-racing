---
interface Props {
  href: string;
  estilo?: 'solido' | 'contorno' | 'claro';
  acento?: 'primary' | 'secondary';
  class?: string;
}

const { href, estilo = 'solido', acento = 'primary', class: extra = '' } = Astro.props;
const esExterno = /^https?:\/\//.test(href);

const base =
  'inline-flex items-center justify-center gap-2 font-bold px-8 py-4 rounded-xl transition-all uppercase tracking-widest text-sm text-center';
const estilos = {
  solido:
    acento === 'secondary'
      ? 'bg-secondary hover:bg-secondary/80 text-white shadow-xl shadow-black/20'
      : 'bg-primary-strong hover:bg-orange-600 text-white shadow-xl shadow-primary/20',
  contorno: 'border border-white/20 hover:bg-white/10 text-white',
  claro: 'bg-white text-primary-strong hover:bg-secondary hover:text-white',
} as const;
---

<a
  href={href}
  class={`${base} ${estilos[estilo]} ${extra}`}
  {...(esExterno ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
