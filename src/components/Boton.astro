---
interface Props {
  href: string;
  estilo?: 'solido' | 'contorno' | 'claro';
  class?: string;
}

const { href, estilo = 'solido', class: extra = '' } = Astro.props;
const esExterno = /^https?:\/\//.test(href);

const base =
  'inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-colors';
const estilos = {
  solido: 'bg-ink text-white hover:bg-neutral-700',
  contorno: 'border border-line bg-white text-ink hover:border-ink',
  claro: 'border border-line bg-white text-ink hover:border-ink',
} as const;
---

<a
  href={href}
  class={`${base} ${estilos[estilo]} ${extra}`}
  {...(esExterno ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
  <span aria-hidden="true">{esExterno ? '↗' : '→'}</span>
</a>
