---
import { whatsappUrl } from '@config/site';

const url = whatsappUrl();
---

{url && (
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-5 right-5 z-[100] inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-sm font-medium text-ink shadow-sm transition-colors hover:border-ink"
  >
    <span class="h-2 w-2 rounded-full bg-[#25D366]" aria-hidden="true"></span>
    WhatsApp
  </a>
)}
