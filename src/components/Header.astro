---
import { site } from '@config/site';

const actual = Astro.url.pathname.replace(/\/?$/, '/');
const esActivo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
---

<header class="fixed top-0 left-0 right-0 z-50 bg-dark/85 backdrop-blur-md border-b border-light/5">
  <nav aria-label="Principal" class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 text-primary font-heading text-xl font-bold tracking-wider hover:text-primary/90 transition-colors shrink-0">
      <span class="text-2xl" aria-hidden="true">🏎️</span>
      TURBO RACING
    </a>

    <ul class="hidden lg:flex items-center gap-6 xl:gap-8">
      {site.nav.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={esActivo(href) ? 'page' : undefined}
            class:list={[
              'text-sm font-medium uppercase tracking-wide transition-colors hover:text-primary',
              esActivo(href) ? 'text-primary' : 'text-light/75',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="/contacto/"
        class="hidden sm:inline-flex bg-primary-strong hover:bg-orange-600 text-white text-xs font-bold px-6 py-2.5 rounded-full transition-all uppercase tracking-widest shadow-lg shadow-primary/20"
      >
        Cotizar ahora
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden p-2 -mr-2 text-light/80 hover:text-primary transition-colors"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path id="icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden lg:hidden bg-dark/95 backdrop-blur-md border-b border-light/5">
    <ul class="flex flex-col px-4 py-4 gap-1">
      {site.nav.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={esActivo(href) ? 'page' : undefined}
            class:list={['block py-3 text-sm font-medium uppercase tracking-wide hover:text-primary transition-colors', esActivo(href) ? 'text-primary' : 'text-light/80']}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-3">
        <a href="/contacto/" class="block text-center bg-primary-strong text-white text-xs font-bold px-6 py-3 rounded-full uppercase tracking-widest">
          Cotizar ahora
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(abierto));
    toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', abierto);
    iconClose?.classList.toggle('hidden', !abierto);
  });
</script>
