---
import { site } from '@config/site';

const actual = Astro.url.pathname.replace(/\/?$/, '/');
const esActivo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
const nav = site.nav.filter((n) => n.href !== '/');
---

<header class="sticky top-0 z-50 border-b border-line bg-white/90 backdrop-blur">
  <nav aria-label="Principal" class="contenedor flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 text-[15px] font-semibold tracking-tight text-ink">
      <span class="h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
      Turbo Racing
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {nav.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={esActivo(href) ? 'page' : undefined}
            class:list={[
              'text-sm transition-colors hover:text-ink',
              esActivo(href) ? 'text-ink underline decoration-primary decoration-2 underline-offset-[6px]' : 'text-muted',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href="/contacto/" class="hidden rounded-full bg-ink px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700 sm:inline-flex">
        Cotizar
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="-mr-2 p-2 text-ink lg:hidden"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <path id="icon-open" stroke-linecap="round" d="M4 8h16M4 16h16" />
          <path id="icon-close" class="hidden" stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-white lg:hidden">
    <ul class="contenedor flex flex-col py-3">
      {site.nav.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={esActivo(href) ? 'page' : undefined}
            class:list={['block border-b border-line py-3.5 text-base', esActivo(href) ? 'text-ink font-medium' : 'text-muted']}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="py-4">
        <a href="/contacto/" class="inline-flex rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-white">Cotizar →</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(abierto));
    toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', abierto);
    iconClose?.classList.toggle('hidden', !abierto);
  });
</script>
