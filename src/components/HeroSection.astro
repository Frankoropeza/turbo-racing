---
interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  title = 'La velocidad está en nuestro ADN',
  subtitle = 'Noticias, eventos y todo sobre el mundo del automovilismo. Bienvenido a Turbo Racing.',
  ctaText = 'Ver Noticias',
  ctaHref = '/noticias',
} = Astro.props;
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-dark via-secondary to-dark"></div>
  <!-- Racing stripe accent -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-0 left-1/4 w-px h-full bg-primary"></div>
    <div class="absolute top-0 left-1/2 w-1 h-full bg-primary"></div>
    <div class="absolute top-0 left-3/4 w-px h-full bg-primary"></div>
  </div>
  <!-- Glow effect -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/10 rounded-full blur-[120px]"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
    <span class="inline-block text-accent text-sm font-semibold uppercase tracking-[0.3em] mb-6">
      Automovilismo de alto rendimiento
    </span>
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl font-bold text-light leading-[1.1] mb-6">
      {title}
    </h1>
    <p class="text-lg md:text-xl text-light/60 max-w-2xl mx-auto mb-10 leading-relaxed">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 text-white font-semibold px-8 py-4 rounded-lg transition-all hover:scale-105 shadow-lg shadow-primary/25"
      >
        {ctaText}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href="#ultimas-noticias"
        class="inline-flex items-center gap-2 border border-light/20 hover:border-primary/50 text-light/80 hover:text-light font-medium px-8 py-4 rounded-lg transition-all"
      >
        Explorar
      </a>
    </div>
  </div>
</section>
