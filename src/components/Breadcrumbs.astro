---
import type { Migaja } from '@lib/seo';
import { sinAcento } from '@lib/texto';

interface Props {
  migas: Migaja[];
}

const { migas } = Astro.props;
---

<nav aria-label="Ruta de navegación" class="contenedor pt-8">
  <ol class="flex flex-wrap items-center gap-2 text-xs text-muted">
    {migas.map((m, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < migas.length - 1 ? (
          <a href={m.url} class="hover:text-ink">{sinAcento(m.nombre)}</a>
        ) : (
          <span aria-current="page" class="text-ink">{sinAcento(m.nombre)}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
