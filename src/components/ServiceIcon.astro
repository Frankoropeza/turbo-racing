---
interface Props {
  icono: 'corporativo' | 'familias' | 'liga';
  class?: string;
}

const { icono, class: clase = 'w-8 h-8' } = Astro.props;
const trazos = {
  corporativo:
    'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  familias:
    'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  liga: 'M13 10V3L4 14h7v7l9-11h-7z',
};
---

<svg class={clase} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={trazos[icono]} />
</svg>
