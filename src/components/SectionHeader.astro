---
import { conAcento } from '@lib/texto';

interface Props {
  badge: string;
  title: string;
  parrafos?: string[];
  slogan?: string;
  /** Número de sección («01»). Opcional. */
  numero?: string;
  /** Usa h1 cuando el encabezado abre la página. */
  nivel?: 'h1' | 'h2';
}

const { badge, title, parrafos = [], slogan, numero, nivel = 'h2' } = Astro.props;
const Heading = nivel;
const tamano = nivel === 'h1' ? 'text-4xl md:text-6xl' : 'text-3xl md:text-5xl';
---

<div class="mb-12 grid gap-8 border-t border-line pt-8 md:mb-16 md:grid-cols-12">
  <div class="md:col-span-6">
    <p class="etiqueta mb-5">{numero && <span class="text-ink">{numero}</span>}{numero && ' — '}{badge}</p>
    <Heading class={`${tamano} font-medium leading-[1.05] tracking-display text-ink`} set:html={conAcento(title)} />
    {slogan && <p class="mt-4 text-base text-muted">{slogan}</p>}
  </div>

  {(parrafos.length > 0 || Astro.slots.has('default')) && (
    <div class="max-w-xl space-y-4 text-base leading-relaxed text-muted md:col-span-5 md:col-start-8 md:pt-10 [&_strong]:font-medium [&_strong]:text-ink">
      {parrafos.map((p) => <p>{p}</p>)}
      <slot />
    </div>
  )}
</div>
