---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Boton from './Boton.astro';
import { conAcento } from '@lib/texto';

interface Props {
  badge: string;
  titulo: string;
  texto: string;
  imagen: ImageMetadata;
  alt: string;
  botones?: { label: string; href: string; estilo: 'solido' | 'contorno' | 'claro' }[];
}

const { badge, titulo, texto, imagen, alt, botones = [] } = Astro.props;
---

<section class="contenedor pt-10 md:pt-16">
  <div class="grid items-end gap-10 md:grid-cols-12">
    <div class="md:col-span-7">
      <p class="etiqueta mb-6">{badge}</p>
      <h1 class="text-4xl font-medium leading-[1.03] tracking-display text-ink md:text-6xl 2xl:text-7xl" set:html={conAcento(titulo)} />
    </div>
    <div class="md:col-span-4 md:col-start-9">
      <p class="text-base leading-relaxed text-muted">{texto}</p>
      {botones.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {botones.map((b) => <Boton href={b.href} estilo={b.estilo}>{b.label}</Boton>)}
        </div>
      )}
    </div>
  </div>

  <div class="mt-12 overflow-hidden rounded-2xl bg-paper md:mt-16">
    <Image
      src={imagen}
      alt={alt}
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[16/9] max-h-[75vh] w-full object-cover object-[50%_20%] md:aspect-[21/9]"
    />
  </div>
</section>
