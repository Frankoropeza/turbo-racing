---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Boton from './Boton.astro';

interface Props {
  badge: string;
  linea1: string;
  linea2: string;
  texto: string;
  imagen: ImageMetadata;
  alt: string;
  botones?: { label: string; href: string; estilo: 'solido' | 'contorno' | 'claro' }[];
  acento?: 'primary' | 'secondary';
}

const { badge, linea1, linea2, texto, imagen, alt, botones = [], acento = 'primary' } = Astro.props;
---

<section class="relative pt-32 pb-24 overflow-hidden bg-dark">
  <div class="absolute inset-0 z-0">
    <Image src={imagen} alt={alt} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="w-full h-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-r from-dark via-dark/85 to-dark/30"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10 text-center lg:text-left">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="inline-block px-4 py-1.5 rounded-full border border-primary/40 bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-[0.35em] mb-6">
          {badge}
        </p>
        <h1 class="font-heading text-5xl md:text-7xl font-bold text-light mb-8 uppercase italic leading-[0.9] tracking-tighter">
          {linea1} <br /> <span class:list={['text-glow', acento === 'secondary' ? 'text-blue-300' : 'text-primary']}>{linea2}</span>
        </h1>
        <p class="text-xl text-light/80 max-w-xl mb-12 font-medium leading-relaxed mx-auto lg:mx-0">{texto}</p>
        {botones.length > 0 && (
          <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
            {botones.map((b) => <Boton href={b.href} estilo={b.estilo} acento={acento}>{b.label}</Boton>)}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
