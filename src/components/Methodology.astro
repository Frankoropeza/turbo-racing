---
import SectionHeader from './SectionHeader.astro';
import { numero } from '@lib/texto';

interface Props {
  badge: string;
  titulo: string;
  pasos: { title: string; description: string }[];
  numeroSeccion?: string;
}

const { badge, titulo, pasos, numeroSeccion } = Astro.props;
---

<section class="contenedor mt-24 md:mt-32">
  <SectionHeader badge={badge} title={titulo} numero={numeroSeccion} />
  <ol class="grid gap-10 md:grid-cols-3">
    {pasos.map((paso, i) => (
      <li>
        <span class="font-serif text-5xl italic text-primary-strong">{numero(i + 1)}</span>
        <h3 class="mt-4 text-lg font-medium tracking-tight text-ink">{paso.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{paso.description}</p>
      </li>
    ))}
  </ol>
</section>
