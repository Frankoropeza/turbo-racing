---
const navItems = [
  {
    title: 'Eventos Corporativos',
    subtitle: 'Team Building & B2B',
    href: '#experiencias'
  },
  {
    title: 'Pit Stop Online',
    subtitle: 'Refacciones & Equipos',
    href: '#experiencias'
  },
  {
    title: 'Liga Pro México',
    subtitle: 'Competición Oficial',
    href: '#eventos'
  },
  {
    title: 'Noticias de Pista',
    subtitle: 'Blogs & Comunidad',
    href: '/noticias'
  }
];
---

<section class="relative z-30 w-full bg-secondary">
  <!-- Racing stripe accent AT THE TOP -->
  <div class="h-1.5 bg-gradient-to-r from-primary via-accent to-primary w-full"></div>

  <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/5 border-b border-white/5">
    {navItems.map((item) => (
      <a 
        href={item.href}
        class="group flex flex-col justify-center px-6 lg:px-10 py-8 lg:py-12 transition-all hover:bg-primary hover:text-white transition-colors duration-500 relative overflow-hidden"
      >
        <h3 class="font-heading text-lg lg:text-xl font-bold uppercase tracking-tight mb-1 group-hover:translate-x-1 transition-transform">
          {item.title}
        </h3>
        <p class="text-[10px] uppercase tracking-[0.2em] text-light/40 group-hover:text-white/80 font-bold transition-colors">
          {item.subtitle}
        </p>

        <!-- Minimalist indicator -->
        <div class="absolute right-8 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-all transform scale-75 group-hover:scale-100">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>
    ))}
  </div>

  <!-- WhatsApp Industrial CTA (Always visible text) -->
  <a 
    href="https://wa.me/525500000000" 
    target="_blank"
    class="fixed bottom-8 right-8 z-[100] flex items-center gap-4 bg-[#25D366] hover:bg-[#128C7E] text-white pl-5 pr-7 py-4 rounded-md shadow-2xl transform hover:-translate-y-1 transition-all group"
  >
    <div class="bg-white/20 p-1.5 rounded">
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </div>
    <div class="flex flex-col">
      <span class="text-[9px] uppercase tracking-widest font-bold opacity-70">Atención Directa</span>
      <span class="text-[12px] font-bold uppercase tracking-tight">Solicitar Cotización</span>
    </div>
  </a>
</section>
