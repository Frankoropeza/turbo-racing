---
import { numero } from '@lib/texto';

interface Props {
  accesos: { title: string; subtitle: string; href: string }[];
}

const { accesos } = Astro.props;
---

<nav aria-label="Accesos rápidos" class="contenedor mt-16">
  <ul class="grid grid-cols-2 gap-px border-y border-line bg-line lg:grid-cols-4">
    {accesos.map((item, i) => (
      <li class="bg-white">
        <a href={item.href} class="group flex h-full flex-col gap-1 px-4 py-6 transition-colors hover:bg-paper lg:px-6">
          <span class="text-xs text-muted">{numero(i + 1)}</span>
          <span class="flex items-center justify-between text-base font-medium text-ink">
            {item.title}
            <span aria-hidden="true" class="text-muted transition-transform group-hover:translate-x-1 group-hover:text-ink">→</span>
          </span>
          <span class="text-sm text-muted">{item.subtitle}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
