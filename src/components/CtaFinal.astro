---
import Boton from './Boton.astro';
import { conAcento } from '@lib/texto';

interface Props {
  titulo: string;
  texto: string;
  boton: { label: string; href: string };
}

const { titulo, texto, boton } = Astro.props;
---

<section class="contenedor mt-24">
  <div class="rounded-2xl bg-paper px-6 py-16 text-center md:px-16 md:py-24">
    <h2 class="mx-auto max-w-3xl text-3xl font-medium leading-[1.1] tracking-display text-ink md:text-5xl" set:html={conAcento(titulo)} />
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted">{texto}</p>
    <div class="mt-8"><Boton href={boton.href}>{boton.label}</Boton></div>
  </div>
</section>
