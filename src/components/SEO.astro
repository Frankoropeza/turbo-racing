---
import { site } from '@config/site';
import { jsonLd, tituloCompleto, urlAbsoluta, type SeoInput } from '@lib/seo';
import { sinAcento } from '@lib/texto';

interface Props {
  seo: SeoInput;
}

const { seo } = Astro.props;
const titulo = tituloCompleto(seo.title, seo.seoTitle);
const canonical = urlAbsoluta(seo.path);
const imagen = urlAbsoluta(seo.image ?? site.ogImage);
const esArticulo = seo.tipo === 'articulo' && seo.articulo;
const schema = JSON.stringify(jsonLd(seo));
---

<title>{titulo}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />
{seo.noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={esArticulo ? 'article' : 'website'} />
<meta property="og:site_name" content={site.nombre} />
<meta property="og:locale" content={site.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={imagen} />
<meta property="og:image:alt" content={sinAcento(seo.title)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={imagen} />

<script is:inline type="application/ld+json" set:html={schema} />
