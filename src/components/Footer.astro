---
import { site, redesActivas } from '@config/site';

const year = new Date().getFullYear();
const redes = redesActivas();
const zonas = site.contacto.zonas;
const servicios = site.nav.filter((n) => n.href.startsWith('/servicios/'));
const catalogo = site.nav.filter((n) => n.href.startsWith('/catalogo/'));
const link = 'text-sm text-muted transition-colors hover:text-ink';
---

<footer class="mt-24 border-t border-line">
  <div class="contenedor grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <a href="/" class="flex items-center gap-2 text-[15px] font-semibold tracking-tight text-ink">
        <span class="h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
        Turbo Racing
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">{site.descripcion}</p>
    </div>

    <div class="md:col-span-2">
      <h2 class="etiqueta mb-4">Servicios</h2>
      <ul class="space-y-2.5">
        {servicios.map((n) => <li><a href={n.href} class={link}>{n.label}</a></li>)}
      </ul>
    </div>

    <div class="md:col-span-2">
      <h2 class="etiqueta mb-4">Catálogo</h2>
      <ul class="space-y-2.5">
        {catalogo.map((n) => <li><a href={n.href} class={link}>{n.label}</a></li>)}
        <li><a href="/noticias/" class={link}>Noticias</a></li>
      </ul>
    </div>

    <div class="md:col-span-3">
      <h2 class="etiqueta mb-4">{zonas.length > 0 ? 'Cobertura' : 'Contacto'}</h2>
      <ul class="space-y-2.5 text-sm text-muted">
        {zonas.map((z) => <li>{z}</li>)}
        {site.contacto.horario && <li>{site.contacto.horario}</li>}
        <li><a href="/contacto/" class={link}>Solicitar cotización →</a></li>
        {redes.map((r) => (
          <li><a href={r.url} target="_blank" rel="noopener noreferrer" class={link}>{r.nombre} ↗</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="contenedor">
   <div class="flex flex-col gap-3 border-t border-line py-6 text-xs text-muted md:flex-row md:items-center md:justify-between">
    <p>&copy; {year} {site.nombreLegal}. Todos los derechos reservados.</p>
    <div class="flex gap-6">
      <a href="/aviso-de-privacidad/" class="hover:text-ink">Aviso de privacidad</a>
      <a href="#top" class="hover:text-ink">↑ Volver arriba</a>
    </div>
   </div>
  </div>
</footer>
