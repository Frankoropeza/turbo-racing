---
const year = new Date().getFullYear();
---

<footer id="footer" class="bg-secondary border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 py-20">
    <div class="grid md:grid-cols-4 gap-12">
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2 text-primary font-heading text-2xl font-bold tracking-tighter mb-6">
          <span class="text-3xl italic">TURBO</span> RACING MX
        </a>
        <p class="text-light/50 text-base leading-relaxed max-w-sm mb-8">
          La comunidad líder en México para entusiastas del Radio Control y Drones FPV. Eventos, soporte técnico y adrenalina pura.
        </p>
        <div class="flex gap-4">
          <!-- Social Icons Placeholder -->
          <div class="w-10 h-10 bg-white/5 rounded-full flex items-center justify-center hover:bg-primary transition-colors cursor-pointer">
            <span class="text-xs uppercase font-bold">IG</span>
          </div>
          <div class="w-10 h-10 bg-white/5 rounded-full flex items-center justify-center hover:bg-primary transition-colors cursor-pointer">
            <span class="text-xs uppercase font-bold">TK</span>
          </div>
          <div class="w-10 h-10 bg-white/5 rounded-full flex items-center justify-center hover:bg-primary transition-colors cursor-pointer">
            <span class="text-xs uppercase font-bold">YT</span>
          </div>
        </div>
      </div>
      <div>
        <h3 class="font-heading text-sm font-bold uppercase tracking-wider text-light mb-6">Navegación</h3>
        <ul class="space-y-4">
          <li><a href="/" class="text-sm text-light/40 hover:text-primary transition-colors uppercase font-medium">Inicio</a></li>
          <li><a href="#experiencias" class="text-sm text-light/40 hover:text-primary transition-colors uppercase font-medium">Experiencias</a></li>
          <li><a href="#eventos" class="text-sm text-light/40 hover:text-primary transition-colors uppercase font-medium">Eventos MX</a></li>
          <li><a href="/noticias" class="text-sm text-light/40 hover:text-primary transition-colors uppercase font-medium">Noticias</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-heading text-sm font-bold uppercase tracking-wider text-light mb-6">Contacto</h3>
        <ul class="space-y-4 text-sm text-light/40 font-medium">
          <li class="flex items-start gap-3">
            <span class="text-primary">📍</span>
            CDMX, Monterrey, Guadalajara.
          </li>
          <li class="flex items-center gap-3">
            <span class="text-primary">✉️</span>
            contacto@turboracing.mx
          </li>
          <li class="flex items-center gap-3">
            <span class="text-primary">📞</span>
            +52 55 0000 0000
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-light/20 uppercase tracking-widest font-bold">
      <div>&copy; {year} Turbo Racing México. All rights reserved.</div>
      <div class="flex gap-8">
        <a href="#" class="hover:text-primary transition-colors">Privacidad</a>
        <a href="#" class="hover:text-primary transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>
