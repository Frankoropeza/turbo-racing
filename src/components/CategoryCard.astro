---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  categoria: CollectionEntry<'categorias'>;
  href: string;
  ctaLabel?: string;
  /** compacta: imagen + nombre + meta (inicio). completa: añade descripción y specs (catálogo). */
  variante?: 'compacta' | 'completa';
  prioridad?: boolean;
}

const { categoria, href, ctaLabel = 'Cotizar', variante = 'completa', prioridad = false } = Astro.props;
const { title, etiqueta, escala, specs, imagen, alt, tipo } = categoria.data;
const { Content } = await render(categoria);
const id = categoria.id.split('/').pop();
---

<article id={id} data-tipo={tipo} class="group flex flex-col scroll-mt-24">
  <a href={href} class="block overflow-hidden rounded-xl bg-paper" tabindex="-1" aria-hidden="true">
    <Image
      src={imagen}
      alt={alt}
      widths={[400, 640, 800, 1000]}
      sizes="(min-width: 1024px) 33vw, 50vw"
      loading={prioridad ? 'eager' : 'lazy'}
      class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </a>

  {variante === 'compacta' ? (
    <>
      <h3 class="mt-3 text-base font-medium tracking-tight text-ink md:text-lg">
        <a href={href} class="hover:underline hover:underline-offset-4">{title}</a>
      </h3>
      <p class="mt-0.5 text-xs text-muted md:text-sm">{etiqueta} · {escala}</p>
    </>
  ) : (
    <>
      <div class="mt-4 flex items-baseline justify-between gap-4">
        <h3 class="text-lg font-medium tracking-tight text-ink">
          <a href={href} class="hover:underline hover:underline-offset-4">{title}</a>
        </h3>
        <span class="shrink-0 text-xs text-muted">Escala {escala}</span>
      </div>
      <p class="mt-1 text-sm text-muted">{etiqueta}</p>
    </>
  )}

  {variante === 'completa' && (
    <>
      <div class="mt-4 text-sm leading-relaxed text-muted">
        <Content />
      </div>
      <p class="mt-4 border-t border-line pt-4 text-xs leading-relaxed text-muted">{specs.join(' · ')}</p>
      <a href={href} class="enlace mt-4 self-start">
        {ctaLabel}<span class="sr-only"> {title}</span> <span aria-hidden="true">→</span>
      </a>
    </>
  )}
</article>
