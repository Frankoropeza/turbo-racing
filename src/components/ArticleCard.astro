---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoriasNoticias } from '@lib/seo';

interface Props {
  noticia: CollectionEntry<'noticias'>;
}

const { noticia } = Astro.props;
const { title, description, category, image, imageAlt } = noticia.data;
const href = `/noticias/${noticia.id}/`;
---

<article class="group">
  <a href={href} class="block overflow-hidden rounded-xl bg-paper" tabindex="-1" aria-hidden="true">
    {image ? (
      <Image src={image} alt={imageAlt ?? ''} widths={[400, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
    ) : (
      <div class="aspect-[4/3] w-full"></div>
    )}
  </a>
  <p class="mt-4 text-xs text-muted">
    {categoriasNoticias[category]}
  </p>
  <h3 class="mt-2 text-lg font-medium leading-snug tracking-tight text-ink">
    <a href={href} class="hover:underline hover:underline-offset-4">{title}</a>
  </h3>
  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
</article>
